{
  "protocol": "AML",
  "version": "1.0-draft",
  "philosophy": {
    "target_users": "pro",
    "assumptions": [
      "AML audio is routed on a dedicated channel",
      "No EQ/comp/limiting/NR is applied to the AML channel",
      "Gain staging is stable and not touched during operation",
      "Users prefer performance (low latency) over consumer-proof robustness"
    ]
  },
  "active_profile": "pro_clean",
  "profiles": {
    "pro_clean": {
      "description": "Dedicated clean channel. Minimal processing. Optimized for lower latency.",
      "audio": {
        "sample_rate_hz": 48000,
        "symbol_duration_ms": 6.0,
        "guard_gap_ms": 0.5,
        "ramp_ms": { "attack": 0.3, "release": 0.3 }
      },
      "detection": {
        "method": "goertzel",
        "min_confidence_db_over_runnerup": 5.0,
        "absolute_threshold": {
          "type": "relative_to_noise_floor",
          "margin_db": 10.0
        },
        "timeouts_ms": {
          "frame_payload": 25,
          "link_dead": 2000
        }
      },
      "bands": {
        "preamble_hz": 2400,
        "type_band": { "base_hz": 3000, "step_hz": 50 },
        "note_band": { "base_hz": 200, "step_hz": 50 },
        "octave_band": { "base_hz": 1300, "step_hz": 80 },
        "value_band": { "base_hz": 4500, "step_hz": 50 },
        "msc_cmd_band": { "base_hz": 3500, "step_hz": 50 },
        "cuelist_band": { "base_hz": 4200, "step_hz": 50 }
      }
    },
    "noisy_analog": {
      "description": "More tolerant profile for less controlled analog paths. Higher latency but more stable detection.",
      "audio": {
        "sample_rate_hz": 48000,
        "symbol_duration_ms": 10.0,
        "guard_gap_ms": 1.0,
        "ramp_ms": { "attack": 0.6, "release": 0.6 }
      },
      "detection": {
        "method": "goertzel",
        "min_confidence_db_over_runnerup": 7.0,
        "absolute_threshold": {
          "type": "relative_to_noise_floor",
          "margin_db": 14.0
        },
        "timeouts_ms": {
          "frame_payload": 45,
          "link_dead": 3000
        }
      },
      "bands": {
        "preamble_hz": 2600,
        "type_band": { "base_hz": 3200, "step_hz": 60 },
        "note_band": { "base_hz": 600, "step_hz": 60 },
        "octave_band": { "base_hz": 1600, "step_hz": 100 },
        "value_band": { "base_hz": 5200, "step_hz": 60 },
        "msc_cmd_band": { "base_hz": 3800, "step_hz": 60 },
        "cuelist_band": { "base_hz": 4400, "step_hz": 60 }
      }
    }
  },
  "symbols": {
    "preamble": {
      "PREAMBLE": "PROFILE.preamble_hz"
    },
    "type": {
      "NOTE_ON": "PROFILE.type_band.base_hz + 0*PROFILE.type_band.step_hz",
      "NOTE_OFF": "PROFILE.type_band.base_hz + 1*PROFILE.type_band.step_hz",
      "PROGRAM_CHANGE": "PROFILE.type_band.base_hz + 2*PROFILE.type_band.step_hz",
      "MSC_LITE": "PROFILE.type_band.base_hz + 3*PROFILE.type_band.step_hz",
      "HEARTBEAT": "PROFILE.type_band.base_hz + 4*PROFILE.type_band.step_hz",
      "PANIC": "PROFILE.type_band.base_hz + 5*PROFILE.type_band.step_hz"
    },
    "note_pitch_class": {
      "C": "PROFILE.note_band.base_hz + 0*PROFILE.note_band.step_hz",
      "C#": "PROFILE.note_band.base_hz + 1*PROFILE.note_band.step_hz",
      "D": "PROFILE.note_band.base_hz + 2*PROFILE.note_band.step_hz",
      "D#": "PROFILE.note_band.base_hz + 3*PROFILE.note_band.step_hz",
      "E": "PROFILE.note_band.base_hz + 4*PROFILE.note_band.step_hz",
      "F": "PROFILE.note_band.base_hz + 5*PROFILE.note_band.step_hz",
      "F#": "PROFILE.note_band.base_hz + 6*PROFILE.note_band.step_hz",
      "G": "PROFILE.note_band.base_hz + 7*PROFILE.note_band.step_hz",
      "G#": "PROFILE.note_band.base_hz + 8*PROFILE.note_band.step_hz",
      "A": "PROFILE.note_band.base_hz + 9*PROFILE.note_band.step_hz",
      "A#": "PROFILE.note_band.base_hz + 10*PROFILE.note_band.step_hz",
      "B": "PROFILE.note_band.base_hz + 11*PROFILE.note_band.step_hz"
    },
    "octave": {
      "range": { "min": 0, "max": 10 },
      "formula": "PROFILE.octave_band.base_hz + octave*PROFILE.octave_band.step_hz"
    },
    "value_0_15": {
      "range": { "min": 0, "max": 15 },
      "formula": "PROFILE.value_band.base_hz + value*PROFILE.value_band.step_hz"
    },
    "msc_cmd": {
      "GO": "PROFILE.msc_cmd_band.base_hz + 0*PROFILE.msc_cmd_band.step_hz",
      "STOP": "PROFILE.msc_cmd_band.base_hz + 1*PROFILE.msc_cmd_band.step_hz",
      "RESUME": "PROFILE.msc_cmd_band.base_hz + 2*PROFILE.msc_cmd_band.step_hz",
      "LOAD": "PROFILE.msc_cmd_band.base_hz + 3*PROFILE.msc_cmd_band.step_hz"
    },
    "cuelist_0_15": {
      "range": { "min": 0, "max": 15 },
      "formula": "PROFILE.cuelist_band.base_hz + cuelist*PROFILE.cuelist_band.step_hz"
    }
  },
  "encoding": {
    "velocity": {
      "mode": "quantized_4bit",
      "description": "Velocity (0-127) is mapped to 0-15 for legacy-prototype robustness and faster decoding.",
      "map": {
        "formula": "v4 = clamp(round(velocity / 8), 0, 15)",
        "symbol": "value_0_15"
      }
    },
    "program_change": {
      "mode": "quantized_4bit",
      "description": "Program (0-127) mapped to 0-15 in the legacy prototype. Can be extended to 8-bit using two VALUE symbols later.",
      "map": {
        "formula": "p4 = clamp(program >> 3, 0, 15)",
        "symbol": "value_0_15"
      }
    },
    "cue_index": {
      "mode": "quantized_4bit",
      "description": "Cue index encoded as 0-15 in the legacy prototype. Extend later if needed.",
      "symbol": "value_0_15"
    }
  },
  "frames": {
    "NOTE_ON": ["PREAMBLE", "NOTE_ON", "NOTE", "OCTAVE", "VALUE"],
    "NOTE_OFF": ["PREAMBLE", "NOTE_OFF", "NOTE", "OCTAVE"],
    "PROGRAM_CHANGE": ["PREAMBLE", "PROGRAM_CHANGE", "VALUE"],
    "MSC_LITE": ["PREAMBLE", "MSC_LITE", "MSC_CMD", "CUELIST", "VALUE"],
    "HEARTBEAT": ["PREAMBLE", "HEARTBEAT"],
    "PANIC": ["PREAMBLE", "PANIC"]
  },
  "fail_safe": {
    "on_link_dead": ["ALL_NOTES_OFF", "RESET_DECODER_STATE"],
    "on_frame_timeout": ["RESET_DECODER_STATE"]
  },
  "notes": [
    "The JSON uses formulas for symbol frequencies so that profiles can shift bands without redefining full tables.",
    "A runtime implementation should resolve formulas into concrete frequency lists at startup.",
    "For ultra-low latency experiments: reduce symbol_duration_ms and guard_gap_ms in pro_clean and tighten the Goertzel windowing."
  ]
}
